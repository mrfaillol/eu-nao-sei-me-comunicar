 "palavra:zh-CN:怜悯": {
  "texto": "哀憐同情。唐．韓愈〈論今年權停舉選狀〉：「陛下憐憫京師之人，慮其乏食。」也作「憐愍」。",
  "classe": "",
  "pronuncia": "lián mǐn",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E6%86%90%E6%86%AB"
 },
 "palavra:zh-CN:同情": {
  "texto": "一種情緒。指對於他人的遭遇，在情感上發生共鳴，或是對他人的行為表示理解。",
  "classe": "",
  "pronuncia": "tóng qíng",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%90%8C%E6%83%85"
 },
 "palavra:zh-CN:悲天悯人": {
  "texto": "憂傷時局多變，哀憐百姓疾苦。",
  "classe": "",
  "pronuncia": "bēi tiān mǐn rén",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E6%82%B2%E5%A4%A9%E6%86%AB%E4%BA%BA"
 },
 "palavra:zh-CN:慈悲": {
  "texto": "佛教用語。慈，指給予眾生安樂；悲，指拔除眾生痛苦。南朝梁．沈約〈懺悔文〉：「爰始成童，有心嗜慾，不識慈悲，莫辨罪報。」後泛指慈愛、悲憫。如：「慈悲為懷」。元．楊顯之《瀟湘雨》第三折：「哥哥，你只管裡將我來棍棒臨身，不住的拷打。難道你的肚腸能這般硬，再也沒那半點兒慈悲的。」《西遊記》第一回：「好！好！好！今日方知姓也。萬望師父慈悲！既然有姓，再乞賜個名字，卻好呼喚。」《紅樓夢》第一六回：「列位神差略發慈悲，讓我回去和這一個好朋友說一句話就來的。」",
  "classe": "",
  "pronuncia": "cí bēi",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E6%85%88%E6%82%B2"
 },
 "palavra:zh-CN:厌倦": {
  "texto": "厭惡倦怠。",
  "classe": "",
  "pronuncia": "yàn juàn",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%8E%AD%E5%80%A6"
 },
 "palavra:zh-CN:无聊": {
  "texto": "精神空虛、愁悶。",
  "classe": "",
  "pronuncia": "wú liáo",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%84%A1%E8%81%8A"
 },
 "palavra:zh-CN:盼望": {
  "texto": "殷切的等候、期望。",
  "classe": "",
  "pronuncia": "pàn wàng",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%9B%BC%E6%9C%9B"
 },
 "palavra:zh-CN:悲凉": {
  "texto": "悲哀淒涼。",
  "classe": "",
  "pronuncia": "bēi liáng",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E6%82%B2%E6%B6%BC"
 },
 "palavra:zh-CN:孤寂": {
  "texto": "孤獨寂寞。",
  "classe": "",
  "pronuncia": "gū jí",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%AD%A4%E5%AF%82"
 },
 "palavra:zh-CN:彷徨": {
  "texto": "徘徊不前。《文選．古詩十九首．明月何皎皎》：「出戶獨彷徨，愁思當告誰。」也作「旁皇」、「傍偟」、「徬徨」。",
  "classe": "",
  "pronuncia": "páng huáng",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%BD%B7%E5%BE%A8"
 },
 "palavra:zh-CN:疑惑": {
  "texto": "懷疑、不明白。",
  "classe": "",
  "pronuncia": "yí huò",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%96%91%E6%83%91"
 },
 "palavra:zh-CN:迟疑": {
  "texto": "游移不定。",
  "classe": "",
  "pronuncia": "chí yí",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E9%81%B2%E7%96%91"
 },
 "palavra:zh-CN:疲倦": {
  "texto": "勞累困倦。",
  "classe": "",
  "pronuncia": "pí juàn",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%96%B2%E5%80%A6"
 },
 "palavra:zh-CN:疲惫": {
  "texto": "極為疲勞困倦。",
  "classe": "",
  "pronuncia": "pí bèi",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%96%B2%E6%86%8A"
 },
 "palavra:zh-CN:疑心": {
  "texto": "懷疑的感覺、念頭。",
  "classe": "",
  "pronuncia": "yí xīn",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E7%96%91%E5%BF%83"
 },
 "palavra:zh-CN:谨慎": {
  "texto": "小心仔細。",
  "classe": "",
  "pronuncia": "jǐn shèn",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E8%AC%B9%E6%85%8E"
 },
 "palavra:zh-CN:和谐": {
  "texto": "和睦諧順。《書經．無逸》「其惟不言，言乃雍，不敢荒寧」句下唐．孔穎達．正義：「鄭玄云：『其不言之時，時有所言，則群臣皆和諧。』」",
  "classe": "",
  "pronuncia": "hé xié",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%92%8C%E8%AB%A7"
 },
 "palavra:zh-CN:单独": {
  "texto": "獨自一人。",
  "classe": "",
  "pronuncia": "dān dú",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E5%96%AE%E7%8D%A8"
 }
}
