  "classe": "",
  "pronuncia": "huān lè",
  "fonte": "moedict",
  "licenca": "CC-BY-ND-3.0-TW",
  "url": "https://www.moedict.tw/%E6%AD%A1%E6%A8%82"
 },
 "palavra:zh-CN:快乐": {
